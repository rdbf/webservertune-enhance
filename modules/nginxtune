def _site_confs():
    """Return all vhost conf files, excluding the control panel 000- prefix files."""
    try:
        return [f for f in SITES_DIR.glob("*.conf") if not f.name.startswith("000-")]
    except Exception:
        return []


def _extract_uuid_from_conf(cf):
    """Extract site UUID from the Enhance-generated access_log directive in a vhost conf."""
    nc = _nginxconf()
    try:
        for d in nc.parse(cf.read_text()):
            if _is_enhance_log(d):
                u = _enhance_log_uuid(d.args[0])
                if u:
                    return u
    except Exception:
        pass
    return None


# ---------------------------------------------------------------------------
# FileWatcher — tails a file, handles rotation and truncation
# ---------------------------------------------------------------------------

class FileWatcher:
    """Tail a log file, handling rotation and truncation."""

    def __init__(self, path, logger, seek_to_end_on_open=True):
        self.path                = path
        self.logger              = logger
        self.seek_to_end_on_open = seek_to_end_on_open
        self.fh                  = None
        self.inode               = None
        self.position            = 0
        self._open()

    def _open(self):
        """Open the file and record its inode. Seeks to end if seek_to_end_on_open is set.

        The path may be inside a tenant webspace, so it is opened with O_NOFOLLOW
        (and O_NONBLOCK, so a FIFO cannot block the thread) and must be a regular file.
        """
        try:
            fd = os.open(self.path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
                         | getattr(os, "O_CLOEXEC", 0))
            try:
                st = os.fstat(fd)
                if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                    raise OSError(f"{self.path} is not a regular single-link file")
            except Exception:
                os.close(fd)
                raise
            self.fh = os.fdopen(fd, "r", errors="replace")
            self.inode = st.st_ino
            if self.seek_to_end_on_open:
                self.fh.seek(0, 2)
            self.position = self.fh.tell()
            self.logger.debug(f"Opened: {self.path} (inode {self.inode})")
        except OSError:
            self.fh    = None
            self.inode = None

    def _reopen_if_needed(self):
        """Reopen the file if it has been rotated (inode changed) or truncated."""
        try:
            st = os.lstat(self.path)
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                raise OSError(f"{self.path} is not a regular single-link file")
        except OSError:
            if self.fh:
                self.fh.close()
                self.fh    = None
                self.inode = None
            return

        if self.fh is None:
            self._open()
            return

        if st.st_ino != self.inode:
            self.logger.debug(f"Recreated: {self.path}")
            self.fh.close()
            self._open()
            return

        if st.st_size < self.position:
            self.logger.debug(f"Truncated: {self.path}")
            self.fh.seek(0)
            self.position = 0

    def readlines(self):
        """Return any new lines written since the last read."""
        self._reopen_if_needed()
        if self.fh is None:
            return []
        lines         = self.fh.readlines()
        self.position = self.fh.tell()
        return lines

    def close(self):
        if self.fh:
            self.fh.close()


# ---------------------------------------------------------------------------
# _DestFile — keeps a destination log file handle open in append mode
# ---------------------------------------------------------------------------

class _DestFile:
    """Keep a destination log file open in append mode, reopening on write failure."""

    def __init__(self, path, logger):
        self.path   = path
        self.logger = logger
        self.fh     = None
        self._open()

    def _open(self):
        try:
            self.fh = open(self.path, "a")
        except OSError as e:
            self.logger.error(f"Cannot open dest file {self.path}: {e}")
            self.fh = None

    def write(self, line):
        """Write a line, reopening the file handle if it was lost."""
        if self.fh is None:
            self._open()
            if self.fh is None:
                return
        try:
            self.fh.write(line)
            self.fh.flush()
        except OSError:
            self.fh = None
            self._open()
            if self.fh:
                try:
                    self.fh.write(line)
                    self.fh.flush()
                except OSError as e:
                    self.logger.error(f"Failed to write to {self.path}: {e}")

    def close(self):
        if self.fh:
            self.fh.close()
            self.fh = None


# ---------------------------------------------------------------------------
# PHP log persistence
# ---------------------------------------------------------------------------

def _start_php_log_thread(config, logger):
    """Start the PHP log persistence thread if persistent_php_logs is enabled."""
    if not config.get("general", {}).get("persistent_php_logs", False):
        return
    t = threading.Thread(target=_php_log_watcher, args=(config, logger), daemon=True)
    t.start()
    logger.info("PHP log persistence thread started")


def _php_log_watcher(config, logger):
    """
    Tail per-site php-error.log and php-fpm.log into SITE_LOGS_DIR/{uuid}/php.log.
    The sources are inside the webspace and are opened without following symlinks.
    Site discovery via inotify on sites-enabled plus full scan at startup.
    """
    registry      = {}  # uuid -> {"error": FileWatcher, "fpm": FileWatcher, "dest": _DestFile}
    fname_to_uuid = {}  # conf filename -> uuid
    reg_lock      = threading.Lock()

    def register(uuid, conf_name):
        if uuid in registry:
            return
        if not _ensure_site_log_dir(uuid, logger):
            return
        dest = _DestFile(_site_log_path(uuid, "php.log"), logger)
        registry[uuid] = {
            "error": FileWatcher(f"/var/www/{uuid}/php-error.log", logger, seek_to_end_on_open=False),
            "fpm":   FileWatcher(f"/var/www/{uuid}/php-fpm.log", logger, seek_to_end_on_open=False),
            "dest":  dest,
        }
        fname_to_uuid[conf_name] = uuid
        logger.debug(f"[php_log] Registered site: {uuid}")

    def unregister_by_conf(conf_name):
        uuid = fname_to_uuid.pop(conf_name, None)
        if uuid is None:
            return
        entry = registry.pop(uuid, None)
        if entry:
            entry["error"].close()
            entry["fpm"].close()
            entry["dest"].close()
            logger.debug(f"[php_log] Unregistered site: {uuid}")

    # startup scan
    with reg_lock:
        for cf in SITES_DIR.glob("*.conf"):
            if cf.name.startswith("000-"):
                continue
            uuid = _extract_uuid_from_conf(cf)
            if uuid:
                register(uuid, cf.name)

    def inotify_loop():
        """Watch sites-enabled for new and removed vhost confs to keep the registry current."""
        cmd = [
            "inotifywait", "--monitor", "--quiet",
            "--format", "%e %f",
            "--event", "create",
            "--event", "delete",
            str(SITES_DIR),
        ]
        while True:
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
            except Exception as e:
                logger.error(f"[php_log] inotifywait failed: {e}")
                time.sleep(5)
                continue
            for line in proc.stdout:
                parts = line.strip().split(" ", 1)
                if len(parts) != 2:
                    continue
                event, fname = parts
                if not fname.endswith(".conf") or fname.startswith("000-"):
                    continue
                if "CREATE" in event:
                    cf = SITES_DIR / fname
                    uuid = _extract_uuid_from_conf(cf)
                    if uuid:
                        with reg_lock:
                            register(uuid, fname)
                elif "DELETE" in event:
                    with reg_lock:
                        unregister_by_conf(fname)
            proc.wait()
            time.sleep(5)

    threading.Thread(target=inotify_loop, daemon=True).start()

    cycle = 0
    while True:
        with reg_lock:
            snapshot = list(registry.items())
        for uuid, entry in snapshot:
            # periodically re-check the root-owned log directory
            if cycle % 60 == 0:
                _ensure_site_log_dir(uuid, logger)
            for key in ("error", "fpm"):
                for line in entry[key].readlines():
                    if line.strip():
                        entry["dest"].write(line)
        cycle += 1
        time.sleep(1)
