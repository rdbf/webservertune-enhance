# apply_logging_features
# ---------------------------------------------------------------------------

def _persistent_log_format(fmt_name, ip_var):
    """Build the persistent log_format line for a vhost."""
    return (
        f"log_format {fmt_name}_persistent "
        f"'$time_local - {ip_var} - $http_cf_ipcountry - "
        f"$server_protocol - $status - $request_method - "
        f"$host - $request_uri - $http_user_agent - "
        f"$upstream_cache_status - $request_time - "
        f"$upstream_response_time';\n"
    )


def apply_logging_features(config, logger):
    """
    Add or remove persistent access logging and real IP detection across all
    non-default vhost confs.

    Vhosts are read with the nginx tokenizer (modules/nginxconf). A file nginx
    would not accept, or one where a log_format or a relevant access_log is not
    alone on its own line, is left byte-for-byte unchanged. Any access_log below
    /var/www is always removed. Persistent logging is only added when the vhost
    has the Enhance access_log with a valid webspace UUID, a base log_format with
    a plain name and a ready log directory; otherwise persistent lines are
    removed, so a vhost never keeps an orphaned format or a log without a format.
    The persistent format goes directly after the base log_format, and one
    persistent access_log after each Enhance access_log of the webspace. A file is
    only rewritten when its content changes.
    """
    nc          = _nginxconf()
    general     = config.get("general", {})
    features    = config.get("nginx", {}).get("features", {})
    pers_on     = general.get("persistent_logging", False)
    realip_on   = features.get("real_ip_logging", False)
    # ip_var is derived once here; all format strings must use this variable consistently
    ip_var      = "$actual_addr" if realip_on else "$remote_addr"

    conf_files  = [f for f in _site_confs() if f.name != "default.conf"]
    any_changed = False

    for cf in conf_files:
        filename = cf.name

        try:
            original = cf.read_text()
        except Exception as e:
            logger.error(f"Failed to read {filename}: {e}")
            continue

        try:
            # a variable destination cannot be judged: it is not removed here, the
            # preflight in run() refuses to test or reload while it exists
            legacy = [d for d in nc.parse(original)
                      if d.name == "access_log" and d.args and "$" not in d.args[0]
                      and nc.is_webspace_log(d)]
            text   = nc.remove_directives(original, legacy)
            ds     = nc.parse(text)
        except nc.ConfError as e:
            logger.warning(f"logging_features: {filename} cannot be parsed ({e}), not changing it")
            continue
        has_legacy_log = bool(legacy)

        sole = nc.sole_on_line(text, ds)
        relevant = [d for d in ds if _is_base_fmt(d) or _is_pers_fmt(d)
                    or _is_pers_log(d) or _is_enhance_log(d)]
        if any(sole.get(d.line_start) is not d for d in relevant):
            # not editable line by line; still never keep a log inside a webspace
            if has_legacy_log and _write_checked(cf, text, logger):
                logger.warning(f"logging_features: access_log below /var/www removed — {filename} "
                               "(otherwise left unchanged: a log_format or access_log is not alone "
                               "on its line)")
                any_changed = True
            else:
                logger.warning(f"logging_features: a log_format or access_log in {filename} is not "
                               "alone on its line, not changing it")
            continue

        lines = nc.split_lines(text)

        pers_logs       = []      # args of current persistent access_logs
        n_pers_fmt      = 0
        pers_fmt_line   = None
        has_realip_map  = False
        has_realip_fmt  = False
        uuid            = None
        enh_logs        = 0       # Enhance access_logs of that uuid
        base_fmt        = None
        base_fmt_idx    = None    # line the persistent format is inserted after

        for i, line in enumerate(lines):
            s = line.strip()
            d = sole.get(i)
            if s.startswith("map $http_cf_connecting_ip $actual_addr"):
                has_realip_map = True
            if d is None:
                continue
            if _is_pers_log(d):
                pers_logs.append(d.args)
            elif _is_pers_fmt(d):
                n_pers_fmt += 1
                if pers_fmt_line is None:
                    pers_fmt_line = s
            elif _is_base_fmt(d):
                if "$actual_addr" in s:
                    has_realip_fmt = True
                if base_fmt is None:
                    base_fmt, base_fmt_idx = d.args[0], i
            elif _is_enhance_log(d):
                u = _enhance_log_uuid(d.args[0])
                if uuid is None:
                    uuid = u
                if u is not None and u == uuid:
                    enh_logs += 1

        cur_realip   = has_realip_map and has_realip_fmt
        has_pers_fmt = n_pers_fmt > 0
        has_pers_log = bool(pers_logs)

        want = False
        if pers_on:
            if not uuid:
                logger.debug(f"logging_features: no webspace UUID in {filename}, no persistent log")
            elif not (base_fmt and _FMT_NAME_RE.fullmatch(base_fmt)):
                logger.debug(f"logging_features: no usable log_format in {filename}, no persistent log")
            else:
                want = _ensure_site_log_dir(uuid, logger)

        if want:
            expected_fmt  = _persistent_log_format(base_fmt, ip_var).strip()
            expected_path = str(_site_log_path(uuid, "webserver.log"))
            expected_log  = f"access_log {expected_path} {base_fmt}_persistent;"
            ok_pers = (pers_logs == [[expected_path, f"{base_fmt}_persistent"]] * enh_logs
                       and n_pers_fmt == 1 and pers_fmt_line == expected_fmt)
        else:
            ok_pers = not pers_logs and n_pers_fmt == 0

        if ok_pers and cur_realip == realip_on and not has_legacy_log:
            continue

        # rebuild config
        new_lines       = []
        realip_added    = False
        pers_added      = 0
        pers_fmt_added  = False

        for i, line in enumerate(lines):
            s    = line.strip()
            d    = sole.get(i)
            base = _indent(lines, i)

            if not realip_on and s.startswith("map $http_cf_connecting_ip $actual_addr"):
                continue

            if d is None:
                new_lines.append(line)

            # always strip persistent lines -- re-added below to prevent duplicates
            elif _is_pers_log(d) or _is_pers_fmt(d):
                continue

            elif _is_base_fmt(d):
                if not line.endswith("\n"):
                    line += "\n"
                if realip_on and "$remote_addr" in s:
                    new_lines.append(line.replace("$remote_addr", "$actual_addr"))
                elif not realip_on and "$actual_addr" in s:
                    new_lines.append(line.replace("$actual_addr", "$remote_addr"))
                else:
                    new_lines.append(line)
                if want and i == base_fmt_idx:
                    new_lines.append(_persistent_log_format(base_fmt, ip_var))
                    pers_fmt_added = True

            elif (d.name == "fastcgi_cache_path" and realip_on
                  and not realip_added and not has_realip_map):
                new_lines.append(
                    "map $http_cf_connecting_ip $actual_addr "
                    "{ default $http_cf_connecting_ip; \"\" $remote_addr; }\n"
                )
                new_lines.append(line)
                realip_added = True

            elif _is_enhance_log(d) and want and _enhance_log_uuid(d.args[0]) == uuid:
                new_lines.append(line if line.endswith("\n") else line + "\n")
                new_lines.append(f"{base}{expected_log}\n")
                pers_added += 1

            else:
                new_lines.append(line)

        new_text = "".join(new_lines)
        if pers_fmt_added != bool(pers_added):
            # cannot happen given the checks above, but never write half a feature
            logger.error(f"logging_features: inconsistent persistent log rebuild for {filename}, "
                         "leaving it unchanged")
            continue
        if new_text == original:
            continue
        try:
            nc.parse(new_text)
        except nc.ConfError as e:
            logger.error(f"logging_features: rebuilt {filename} would not parse ({e}), "
                         "leaving it unchanged")
            continue

        try:
            cf.write_text(new_text)
            parts = []
            if has_pers_log != bool(pers_added):
                parts.append(f"persistent logging {'enabled' if pers_added else 'disabled'}")
            elif has_pers_fmt != pers_fmt_added:
                parts.append("orphaned persistent log format removed")
            if cur_realip != realip_on:
                parts.append(f"real IP logging {'enabled' if realip_on else 'disabled'}")
            if has_legacy_log:
                parts.append(f"persistent log moved out of /var/www to {SITE_LOGS_DIR}"
                             if pers_added else "access_log below /var/www removed")
            if not parts:
                parts.append("persistent log format updated")
            logger.warning(f"logging_features: {'; '.join(parts)} — {filename}")
            any_changed = True
        except Exception as e:
            logger.error(f"Failed to write {filename}: {e}")

    return any_changed


def _write_checked(cf, text, logger):
    """Write text to cf only if it parses. Returns True on success."""
    nc = _nginxconf()
    try:
        nc.parse(text)
        cf.write_text(text)
        return True
    except (nc.ConfError, OSError) as e:
        logger.error(f"Failed to write {cf.name}: {e}")
        return False


def _nginx_worker_user():
    """The user nginx workers run as (the `user` directive), default www-data."""
    try:
        m = re.search(r'(?m)^\s*user\s+([A-Za-z0-9_.-]+)', NGINX_CONF.read_text())
        if m:
            return m.group(1)
    except OSError:
        pass
    return DEFAULT_WORKER_USER


_acl_done = set()


def _grant_worker_traverse(path, logger):
    """Give the nginx worker user search (x) permission on a directory via ACL.

    On log reopen (SIGUSR1, used by logrotate) nginx workers reopen access logs
    themselves, as the worker user, so they must be able to traverse the
    directory; read access stays limited to root and the adm group.
    """
    try:
        st = os.lstat(path)
    except OSError as e:
        logger.error(f"setfacl: cannot stat {path}: {e}")
        return False
    user = _nginx_worker_user()
    key = (str(path), st.st_dev, st.st_ino, user)
    if key in _acl_done:
        return True
    try:
        r = subprocess.run(["setfacl", "-m", f"u:{user}:x", "--", str(path)],
                           capture_output=True, text=True, timeout=10)
    except FileNotFoundError:
        logger.error(f"setfacl not found (apt install acl); nginx workers could not reopen "
                     f"logs in {path}, not using it")
        return False
    except Exception as e:
        logger.error(f"setfacl on {path} failed: {e}")
        return False
    if r.returncode != 0:
        logger.error(f"setfacl on {path} failed: {r.stderr.strip()}")
        return False
    _acl_done.add(key)
    return True


def _ensure_site_log_dir(uuid, logger):
    """
    Create SITE_LOGS_DIR/<uuid>/ as a root-owned directory (root:adm, 0750,
    plus search permission for the nginx worker user).

    Never touches /var/www. The parent of SITE_LOGS_DIR must be a real
    directory owned by root and not group/other-writable, and every component
    is checked with lstat, so a symlinked directory is refused rather than
    followed. Returns True when the directory is ready for nginx to write into.
    """
    if not _UUID_RE.fullmatch(uuid or ""):
        logger.error(f"Refusing to create log dir for unexpected name {uuid!r}")
        return False
    try:
        gid = grp.getgrnam(SITE_LOGS_GROUP).gr_gid
    except KeyError:
        gid = 0
    euid    = os.geteuid()
    is_root = euid == 0
    try:
        pst = os.lstat(SITE_LOGS_DIR.parent)
        if (not stat.S_ISDIR(pst.st_mode) or pst.st_uid not in (0, euid)
                or pst.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            logger.error(f"{SITE_LOGS_DIR.parent} must be a directory owned by root and not "
                         "group/other-writable; not using it for site logs")
            return False
        for d in (SITE_LOGS_DIR, SITE_LOGS_DIR / uuid):
            try:
                os.mkdir(d, 0o750)
            except FileExistsError:
                pass
            st = os.lstat(d)
            if not stat.S_ISDIR(st.st_mode):
                logger.error(f"{d} is not a directory (symlink?), refusing to use it")
                return False
            if st.st_uid not in (0, euid):
                logger.error(f"{d} is owned by uid {st.st_uid}, refusing to use it")
                return False
            if d != SITE_LOGS_DIR:
                # files nginx (as root) or this service will open must be real files
                for name in ("webserver.log", "php.log"):
                    try:
                        fst = os.lstat(d / name)
                    except FileNotFoundError:
                        continue
                    if not stat.S_ISREG(fst.st_mode) or fst.st_nlink != 1:
                        logger.error(f"{d / name} is not a regular single-link file, "
                                     "refusing to use it")
                        return False
            if is_root:
                if st.st_uid != 0 or st.st_gid != gid:
                    os.chown(d, 0, gid, follow_symlinks=False)
                if (st.st_mode & 0o7777) != 0o750:
                    os.chmod(d, 0o750)
                if not _grant_worker_traverse(d, logger):
                    return False
        return True
    except Exception as e:
        logger.error(f"Failed to set up log directory for {uuid}: {e}")
        return False


