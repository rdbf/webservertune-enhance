# apply_include_features
# ---------------------------------------------------------------------------

def apply_include_features(config, logger):
    """
    Add or remove managed include directives (ssl, hardening, cms, redirects)
    from all non-default vhost confs. Inserts after the vhost_includes line,
    or before the closing brace if that line is absent.
    """
    features        = config.get("nginx", {}).get("features", {})
    redirects_on    = config.get("general", {}).get("nginx_redirects", False)
    cacheexclude_on = config.get("nginx-cacheexclude", {}).get("enabled", False)

    if cacheexclude_on:
        CACHE_EXCLUDES_DIR.mkdir(parents=True, exist_ok=True)

    include_map = {
        "ssl_upgrade":      f"include {OVERRIDES}/ssl.conf",
        "server_hardening": f"include {OVERRIDES}/hardening.conf",
        "cms_protection":   f"include {OVERRIDES}/cms.conf",
    }

    expected   = [v for k, v in include_map.items() if features.get(k, False)]
    manageable = list(include_map.values())

    conf_files  = [f for f in _site_confs() if f.name != "default.conf"]
    any_changed = False

    for cf in conf_files:
        filename     = cf.name
        redirect_inc = f"include {REDIRECTS_DIR}/{cf.stem}.conf"
        cacheexc_inc = f"include {CACHE_EXCLUDES_DIR}/{cf.stem}.conf"

        # Ensure the per-domain cache-exclude file exists before its include is
        # added, otherwise nginx -t fails on a missing include path. The
        # nginxcacheexclude module fills in the real rules; an empty placeholder
        # is valid in the meantime.
        if cacheexclude_on:
            ce_path = CACHE_EXCLUDES_DIR / f"{cf.stem}.conf"
            if not ce_path.exists():
                try:
                    ce_path.write_text("")
                except Exception as e:
                    logger.error(f"Failed to create placeholder cache-exclude for {cf.stem}: {e}")

        try:
            lines = cf.read_text().splitlines(keepends=True)
        except Exception as e:
            logger.error(f"Failed to read {filename}: {e}")
            continue

        file_expected   = (expected
                           + ([redirect_inc] if redirects_on else [])
                           + ([cacheexc_inc] if cacheexclude_on else []))
        file_manageable = manageable + [redirect_inc, cacheexc_inc]

        current  = []
        unwanted = []
        managed_filenames = {Path(v).name for v in manageable}

        for line in lines:
            s = line.strip()
            if not s.startswith("include "):
                continue
            if s.rstrip(";") == redirect_inc:
                current.append(redirect_inc)
                continue
            if s.rstrip(";") == cacheexc_inc:
                current.append(cacheexc_inc)
                continue
            inc_filename = Path(s.rstrip(";").split()[-1]).name
            if inc_filename not in managed_filenames:
                continue
            canonical = next(v for v in manageable if Path(v).name == inc_filename)
            if s.rstrip(";") == canonical:
                current.append(canonical)
            else:
                unwanted.append(s.rstrip(";"))

        to_add    = [i for i in file_expected if i not in current]
        to_remove = [i for i in file_manageable if i in current and i not in file_expected]

        if not to_add and not to_remove and not unwanted:
            continue

        new_lines        = []
        includes_written = False

        for i, line in enumerate(lines):
            s = line.strip()

            skip = False
            for inc in to_remove + unwanted:
                if s == f"{inc};" or s == inc:
                    skip = True
                    break
            if skip:
                continue

            new_lines.append(line)

            if "include vhost_includes/" in line and not includes_written:
                base = _indent(lines, i)
                for inc in to_add:
                    new_lines.append(f"{base}{inc};\n")
                includes_written = True

        # fallback: insert before closing brace if vhost_includes line was not found
        if not includes_written and to_add:
            for j in range(len(new_lines) - 1, -1, -1):
                if new_lines[j].strip() == "}":
                    for inc in to_add:
                        new_lines.insert(j, f"{inc};\n")
                    includes_written = True
                    break

        try:
            cf.write_text("".join(new_lines))
            parts = []
            if to_add:
                names = [k for k, v in include_map.items() if v in to_add]
                if redirect_inc in to_add:
                    names.append("nginx_redirects")
                if cacheexc_inc in to_add:
                    names.append("cache_exclude")
                parts.append(f"added {', '.join(names)}")
            if to_remove:
                names = [k for k, v in include_map.items() if v in to_remove]
                if redirect_inc in to_remove:
                    names.append("nginx_redirects")
                if cacheexc_inc in to_remove:
                    names.append("cache_exclude")
                parts.append(f"removed {', '.join(names)}")
            if unwanted:
                parts.append(f"cleaned {len(unwanted)} legacy includes")
            logger.warning(f"include_features: {'; '.join(parts)} — {filename}")
            any_changed = True
        except Exception as e:
            logger.error(f"Failed to write {filename}: {e}")

    return any_changed


