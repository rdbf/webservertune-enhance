#!/usr/bin/env python3
"""
nginxtune
Nginx configuration management for Enhance hosting environments.
Manages HTTP/3, security includes, logging, FastCGI cache and body size settings.
Called by webservertune-enhance main program.
"""

import grp
import importlib.util
import logging
import os
import re
import stat
import shutil
import subprocess
import threading
import time
from datetime import datetime, timedelta
from importlib.machinery import SourceFileLoader
from pathlib import Path

SITES_DIR     = Path("/etc/nginx/sites-enabled")
NGINX_CONF    = Path("/etc/nginx/nginx.conf")
BACKUP_BASE   = Path("/opt/webservertune-enhance/backups/nginx")
OVERRIDES     = Path("/opt/webservertune-enhance/overrides")
REDIRECTS_DIR = Path("/opt/webservertune-enhance/redirects")
CACHE_EXCLUDES_DIR = Path("/opt/webservertune-enhance/cache-excludes")

# Persistent per-site logs live in a root-owned tree outside the webspaces.
# They used to be written to /var/www/<uuid>/logs/, which the site user can
# write: the nginx master opens access_log files as root and follows symlinks,
# and this service chowned/chmodded entries there, so a tenant could redirect
# either to a host file. Lines pointing at the legacy location are migrated.
SITE_LOGS_DIR   = Path("/var/log/webservertune-enhance/sites")
SITE_LOGS_GROUP = "adm"   # readable by log shippers in the adm group (e.g. Vector)
_UUID_RE        = re.compile(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}', re.IGNORECASE)  # use fullmatch
DEFAULT_WORKER_USER = "www-data"

ENHANCE_LOG_DIR = "/var/local/enhance/webserver_logs/"
_FMT_NAME_RE    = re.compile(r'[A-Za-z0-9_.-]+')

_nginxconf_mod = None


def _nginxconf():
    """The shared nginx config reader (modules/nginxconf), loaded once."""
    global _nginxconf_mod
    if _nginxconf_mod is None:
        path   = Path(__file__).resolve().parent / "nginxconf"
        loader = SourceFileLoader("nginxconf", str(path))
        spec   = importlib.util.spec_from_loader("nginxconf", loader)
        mod    = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        _nginxconf_mod = mod
    return _nginxconf_mod


def _site_log_path(uuid, name):
    return SITE_LOGS_DIR / uuid / name


def _enhance_log_uuid(path):
    """UUID from an Enhance access log path /var/local/enhance/webserver_logs/<uuid>.log."""
    if not path.startswith(ENHANCE_LOG_DIR):
        return None
    name = path[len(ENHANCE_LOG_DIR):]
    if not name.endswith(".log"):
        return None
    u = name[:-len(".log")]
    return u if _UUID_RE.fullmatch(u) else None


def _in_server(d):
    return "server" in d.ctx and not set(d.ctx) & _nginxconf().DATA_BLOCKS


_PERS_LOG_RE = None


def _is_pers_log(d):
    """Exactly a persistent access_log this service writes:
    SITE_LOGS_DIR/<uuid>/webserver.log, no variables."""
    global _PERS_LOG_RE
    if _PERS_LOG_RE is None or _PERS_LOG_RE[0] != str(SITE_LOGS_DIR):
        _PERS_LOG_RE = (str(SITE_LOGS_DIR), re.compile(re.escape(str(SITE_LOGS_DIR)) + "/"
                        + _UUID_RE.pattern + "/webserver\\.log", re.IGNORECASE))
    return (d.name == "access_log" and len(d.args) >= 1 and _in_server(d)
            and bool(_PERS_LOG_RE[1].fullmatch(d.args[0])))


def _is_pers_fmt(d):
    # the vhost file is included at http level, where log_format lives
    return d.name == "log_format" and bool(d.args) and d.ctx == () and d.args[0].endswith("_persistent")


def _is_base_fmt(d):
    return d.name == "log_format" and bool(d.args) and d.ctx == () and not d.args[0].endswith("_persistent")


def _is_enhance_log(d):
    return (d.name == "access_log" and bool(d.args) and _in_server(d)
            and d.args[0].startswith(ENHANCE_LOG_DIR))


NGINX_DROPIN  = Path("/etc/systemd/system/nginx.service.d/webservertune-enhance.conf")
ALT_SVC       = 'h3=":443"; ma=86400'

# nginxcacheexclude is a sub-module invoked from run()/cleanup() so that all
# vhost/cache-exclude file changes flow through this module's backup/test/reload
# path. Loaded lazily and cached.
MODULES_DIR        = Path(__file__).resolve().parent
_cacheexclude_mod  = None


def _apply_cache_excludes(config, logger):
    """Load the nginxcacheexclude sub-module (once) and regenerate its files.

    Returns True if any cache-exclude file changed. Never reloads nginx itself —
    the caller's run() handles nginx -t and reload/restore.
    """
    global _cacheexclude_mod
    try:
        if _cacheexclude_mod is None:
            path   = MODULES_DIR / "nginxcacheexclude"
            loader = SourceFileLoader("nginxcacheexclude", str(path))
            spec   = importlib.util.spec_from_loader("nginxcacheexclude", loader)
            _cacheexclude_mod = importlib.util.module_from_spec(spec)
            loader.exec_module(_cacheexclude_mod)
        return _cacheexclude_mod.apply(config, logger)
    except Exception as e:
        logger.error(f"cache-exclude apply failed: {e}")
        return False

SENTINEL_BEGIN = "# Custom nginxtune config"
SENTINEL_END   = "# End custom nginxtune config"


# ---------------------------------------------------------------------------
# inotify watch + debounce
# ---------------------------------------------------------------------------

def watch(config, logger):
    """Entry point called by main program. Runs startup check then watches for changes."""
    logger.info("nginxtune starting")

    _apply_restart_manage(config, logger)

    # brief delay on startup to allow nginx to fully initialise before
    # attempting any config changes or reloads
    time.sleep(15)

    run(config, logger)

    _start_php_log_thread(config, logger)

    cmd = [
        "inotifywait", "--monitor", "--quiet",
        "--format", "%e %f",
        "--event", "modify",
        "--event", "create",
        "--event", "moved_to",
        str(SITES_DIR),
    ]

    debounce_timer = None
    debounce_lock  = threading.Lock()
    debounce_secs  = config.get("general", {}).get("debounce_seconds", 10)

    def debounced_run():
        run(config, logger)

    def schedule_debounce():
        nonlocal debounce_timer
        with debounce_lock:
            if debounce_timer is not None:
                debounce_timer.cancel()
            debounce_timer = threading.Timer(debounce_secs, debounced_run)
            debounce_timer.start()

    while True:
        try:
            logger.info(f"Watching {SITES_DIR} via inotifywait")
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
        except FileNotFoundError:
            logger.error("inotifywait not found — install inotify-tools: apt install inotify-tools")
            return
        except Exception as e:
            logger.error(f"Failed to start inotifywait: {e}")
            time.sleep(5)
            continue

        for line in proc.stdout:
            parts = line.strip().split(" ", 1)
            if len(parts) == 2 and parts[1].endswith(".conf"):
                logger.debug(f"inotify event: {line.strip()}")
                schedule_debounce()

        ret = proc.wait()
        logger.warning(f"inotifywait exited (code {ret}), restarting watch in 5s")
        time.sleep(5)


# ---------------------------------------------------------------------------
# restart_manage: systemd drop-in management
# ---------------------------------------------------------------------------

# drop-in content that prevents nginx from hitting systemd restart limits
DROPIN_CONTENT = """\
[Service]
RestartSec=15s

[Unit]
StartLimitIntervalSec=0
"""

def log_preflight_ok(logger, action):
    """Whether nginx may be started, tested or reloaded: no access_log/error_log
    anywhere in the include graph may reach into a webspace (nginx opens them as
    root). Logs the reason when it may not."""
    try:
        problems, errors = _nginxconf().webspace_log_check(str(NGINX_CONF))
    except Exception as e:
        problems, errors = [], [f"preflight failed: {e}"]
    if problems or errors:
        logger.error(f"Not {action}: log destination check failed: "
                     + "; ".join((problems + errors)[:5]))
        return False
    return True


def _apply_restart_manage(config, logger):
    """Install or remove the nginx systemd drop-in based on the nginx_restart_manage setting."""
    enabled       = config.get("general", {}).get("nginx_restart_manage", False)
    dropin_exists = NGINX_DROPIN.exists()

    if enabled and not dropin_exists:
        try:
            NGINX_DROPIN.parent.mkdir(parents=True, exist_ok=True)
            NGINX_DROPIN.write_text(DROPIN_CONTENT)
            subprocess.run(["systemctl", "daemon-reload"], check=True)
            if log_preflight_ok(logger, "reloading nginx after installing the drop-in"):
                subprocess.run(["systemctl", "reload", "nginx"], check=True)
                logger.warning("restart_manage: drop-in installed, daemon-reload and nginx reload done")
            else:
                logger.warning("restart_manage: drop-in installed and daemon-reload done, nginx not reloaded")
        except Exception as e:
            logger.error(f"restart_manage: failed to install drop-in: {e}")

    elif not enabled and dropin_exists:
        try:
            NGINX_DROPIN.unlink()
            subprocess.run(["systemctl", "daemon-reload"], check=True)
            logger.warning("restart_manage: drop-in removed, daemon-reload done")
        except Exception as e:
            logger.error(f"restart_manage: failed to remove drop-in: {e}")

    else:
        logger.debug(f"restart_manage: no change needed (enabled={enabled}, exists={dropin_exists})")


# ---------------------------------------------------------------------------
# Main run: backup → apply → test → reload or restore
# ---------------------------------------------------------------------------

def run(config, logger):
    """
    Back up all vhost confs and nginx.conf, apply all configured features, test with
    nginx -t, reload nginx if changed, or restore from backup and exit if reload fails.
    """
    backup_dir = _create_backup(logger)
    if not backup_dir:
        logger.error("Backup failed, aborting run")
        return

    changed  = False
    changed |= apply_nginx_conf(config, logger)
    changed |= apply_http3_enable(config, logger)
    changed |= apply_quic_gso_enable(config, logger)
    # generate cache-exclude files before their includes are (re)confirmed below
    changed |= _apply_cache_excludes(config, logger)
    changed |= apply_include_features(config, logger)
    changed |= apply_logging_features(config, logger)
    changed |= apply_fastcgi_cache_settings(config, logger)
    changed |= apply_client_max_body_size(config, logger)

    if not changed:
        logger.info("All configs up to date, no changes needed")
        _cleanup_backup(backup_dir, logger)
        _cleanup_old_backups(config.get("general", {}).get("backup_retention_days", 30), logger)
        return

    # nginx -t opens every log file as root: check the destinations first
    if not log_preflight_ok(logger, "testing or reloading the nginx config"):
        if _restore_backup(backup_dir, logger):
            logger.info("Configs restored from backup")
        _cleanup_backup(backup_dir, logger)
        return

    ok, output = _test_nginx()
    if not ok:
        logger.error(f"nginx -t failed: {output}")
        if _restore_backup(backup_dir, logger):
            logger.info("Configs restored from backup")
        _cleanup_backup(backup_dir, logger)
        return

    if _reload_nginx(logger):
        logger.info("Configuration updated, nginx reloaded")
    else:
        logger.error(f"nginx reload failed — restoring backup and restarting service")
        if _restore_backup(backup_dir, logger):
            if not log_preflight_ok(logger, "reloading the restored config"):
                pass
            elif _reload_nginx(logger):
                logger.info("Restored config reloaded successfully")
            else:
                logger.error("Reload of restored config also failed")
        else:
            logger.error("Backup restore failed")
        # flush logs before forcing process exit so systemd restarts cleanly
        logging.shutdown()
        os._exit(0)

    _cleanup_old_backups(config.get("general", {}).get("backup_retention_days", 30), logger)


# ---------------------------------------------------------------------------
# Backup helpers
# ---------------------------------------------------------------------------

def _create_backup(logger):
    """
    Copy all vhost confs and nginx.conf to a timestamped backup directory.
    Returns the path or None on failure.
    """
    backup_dir = BACKUP_BASE / datetime.now().strftime("%Y%m%d_%H%M%S")
    try:
        backup_dir.mkdir(parents=True, exist_ok=True)
        for f in SITES_DIR.glob("*.conf"):
            shutil.copy2(f, backup_dir)
        if NGINX_CONF.exists():
            shutil.copy2(NGINX_CONF, backup_dir / NGINX_CONF.name)
        logger.info(f"Backup created: {backup_dir}")
        return backup_dir
    except Exception as e:
        logger.error(f"Failed to create backup: {e}")
        return None


def _restore_backup(backup_dir, logger):
    """Restore vhost confs and nginx.conf from a backup directory. Returns True on success."""
    try:
        for f in backup_dir.glob("*.conf"):
            if f.name == NGINX_CONF.name:
                shutil.copy2(f, NGINX_CONF)
            else:
                shutil.copy2(f, SITES_DIR / f.name)
        logger.info(f"Restored from backup: {backup_dir}")
        return True
    except Exception as e:
        logger.error(f"Failed to restore backup: {e}")
        return False


def _cleanup_backup(backup_dir, logger):
    """Remove a backup directory after a successful run where no reload was needed."""
    try:
        shutil.rmtree(backup_dir)
        logger.info(f"Removed backup: {backup_dir}")
    except Exception as e:
        logger.error(f"Failed to remove backup {backup_dir}: {e}")


def _cleanup_old_backups(retention_days, logger):
    """Remove backup directories older than retention_days."""
    try:
        if not BACKUP_BASE.exists():
            return
        cutoff = datetime.now() - timedelta(days=retention_days)
        removed = 0
        for d in BACKUP_BASE.iterdir():
            if not d.is_dir():
                continue
            try:
                ts = datetime.strptime(d.name, "%Y%m%d_%H%M%S")
                if ts < cutoff:
                    shutil.rmtree(d)
                    removed += 1
            except ValueError:
                continue
        if removed:
            logger.info(f"Removed {removed} old backup(s) older than {retention_days} days")
    except Exception as e:
        logger.error(f"Failed to clean up old backups: {e}")


# ---------------------------------------------------------------------------
# Nginx helpers
# ---------------------------------------------------------------------------

def _test_nginx():
    """Run nginx -t and return (success, stderr output)."""
    try:
        result = subprocess.run(["nginx", "-t"], capture_output=True, text=True)
        return result.returncode == 0, result.stderr
    except Exception as e:
        return False, str(e)


def _reload_nginx(logger):
    """Reload nginx via systemctl. Returns True on success."""
    try:
        result = subprocess.run(
            ["systemctl", "reload", "nginx"], capture_output=True, text=True
        )
        return result.returncode == 0
    except Exception as e:
        logger.error(f"Failed to reload nginx: {e}")
        return False


# ---------------------------------------------------------------------------
# Indentation helpers
# ---------------------------------------------------------------------------

def _indent(lines, index, fallback="    "):
    """Return the leading whitespace of a line, used to match surrounding indentation."""
    try:
        line = lines[index]
        n    = len(line) - len(line.lstrip())
        return " " * n
    except Exception:
        return fallback


def _php_indent(lines, index, fallback="                "):
    """Return the indentation for content inside a PHP location block (line indent + 4 spaces)."""
    try:
        line = lines[index]
        n    = len(line) - len(line.lstrip())
        return " " * (n + 4)
    except Exception:
        return fallback


# ---------------------------------------------------------------------------
# apply_nginx_conf
# ---------------------------------------------------------------------------

def apply_nginx_conf(config, logger):
    """
    Manage Custom nginxtune config sentinel blocks in nginx.conf.
    Main context block: quic_bpf on (inserted before events {}).
    http context block: quic_gso on, quic_retry on, ssl_early_data on
    (inserted at the top of http {}).
    Both blocks are stripped and rebuilt on every run.
    quic_directives_enable requires http3_enable = true to be effective.
    """
    if not NGINX_CONF.exists():
        logger.error(f"nginx.conf not found: {NGINX_CONF}")
        return False

    features  = config.get("nginx", {}).get("features", {})
    effective = features.get("quic_directives_enable", False) and features.get("http3_enable", False)

    try:
        original = NGINX_CONF.read_text()
        lines    = original.splitlines(keepends=True)
    except Exception as e:
        logger.error(f"Failed to read nginx.conf: {e}")
        return False

    # strip all existing sentinel blocks
    stripped = []
    in_block = False
    for line in lines:
        s = line.strip()
        if s == SENTINEL_BEGIN:
            in_block = True
            continue
        if s == SENTINEL_END:
            in_block = False
            continue
        if not in_block:
            stripped.append(line)

    # rebuild with sentinel blocks inserted at the correct positions
    result        = []
    main_inserted = False
    http_inserted = False

    for line in stripped:
        s = line.strip()

        # main context block goes before events {
        if not main_inserted and s.startswith("events") and "{" in s:
            if effective:
                result.append(f"{SENTINEL_BEGIN}\n")
                result.append("quic_bpf on;\n")
                result.append(f"{SENTINEL_END}\n")
            main_inserted = True

        result.append(line)

        # http context block goes at the top of http {
        if not http_inserted and s == "http {":
            if effective:
                result.append(f"\t{SENTINEL_BEGIN}\n")
                result.append("\tquic_gso on;\n")
                result.append("\tquic_retry on;\n")
                result.append("\tssl_early_data on;\n")
                result.append(f"\t{SENTINEL_END}\n")
            http_inserted = True

    new_content = "".join(result)

    if new_content == original:
        return False

    try:
        NGINX_CONF.write_text(new_content)
        action = "enabled" if effective else "disabled"
        logger.warning(f"apply_nginx_conf: quic directives {action} — updated nginx.conf")
        return True
    except Exception as e:
        logger.error(f"Failed to write nginx.conf: {e}")
        return False


# ---------------------------------------------------------------------------
# apply_http3_enable
# ---------------------------------------------------------------------------

def apply_http3_enable(config, logger):
    """
    Add or remove HTTP/3 QUIC listeners, http2/http3 directives, Alt-Svc headers,
    and the FastCGI HTTP_HOST fix across all vhost confs. Skips files already
    matching the target state.
    """
    features     = config.get("nginx", {}).get("features", {})
    http3        = features.get("http3_enable", False)
    conf_files   = _site_confs()
    any_changed  = False

    for cf in conf_files:
        filename   = cf.name
        is_default = filename == "default.conf"

        try:
            lines = cf.read_text().splitlines(keepends=True)
        except Exception as e:
            logger.error(f"Failed to read {filename}: {e}")
            continue

        has_php = any("location ~ \\.php$" in l for l in lines)

        # target state varies between the default.conf and regular vhost confs
        if is_default:
            if http3:
                t_listeners  = [
                    "listen 80 default_server reuseport",
                    "listen [::]:80 default_server reuseport",
                    "listen 443 ssl default_server reuseport",
                    "listen [::]:443 ssl default_server reuseport",
                    "listen 443 quic default_server reuseport",
                    "listen [::]:443 quic default_server reuseport",
                ]
                t_directives = ["http2 on", "http3 on"]
            else:
                t_listeners  = [
                    "listen 80 default_server reuseport",
                    "listen [::]:80 default_server reuseport",
                    "listen 443 ssl http2 default_server reuseport",
                    "listen [::]:443 ssl http2 default_server reuseport",
                ]
                t_directives = []
            t_headers  = []
            t_php_adds = []
        else:
            if http3:
                t_listeners  = [
                    "listen 80",
                    "listen [::]:80",
                    "listen 443 ssl",
                    "listen [::]:443 ssl",
                    "listen 443 quic",
                    "listen [::]:443 quic",
                ]
                t_directives = ["http2 on", "http3 on"]
                t_headers    = [f"add_header Alt-Svc '{ALT_SVC}'"]
                t_php_adds   = ([f"add_header Alt-Svc '{ALT_SVC}'", "fastcgi_param HTTP_HOST $host"]
                                if has_php else [])
            else:
                t_listeners  = [
                    "listen 80",
                    "listen [::]:80",
                    "listen 443 ssl http2",
                    "listen [::]:443 ssl http2",
                ]
                t_directives = []
                t_headers    = []
                t_php_adds   = []

        # detect current state
        c_listeners = []
        c_directives = []
        c_headers    = []
        c_php_adds   = []
        in_php       = False

        for line in lines:
            s = line.strip()
            if s.startswith("listen ") and not s.startswith("#"):
                if any(p in s for p in ["80", "443"]):
                    c_listeners.append(s.rstrip(";"))
            elif s in ["http2 on;", "http3 on;"]:
                c_directives.append(s.rstrip(";"))
            elif f"add_header Alt-Svc '{ALT_SVC}'" in line and not in_php and not is_default:
                c_headers.append(s.rstrip(";"))
            elif in_php and not is_default:
                if f"add_header Alt-Svc '{ALT_SVC}'" in line:
                    c_php_adds.append(s.rstrip(";"))
                elif "fastcgi_param HTTP_HOST $host;" in line:
                    c_php_adds.append(s.rstrip(";"))
            if "location ~ \\.php$" in s and not is_default:
                in_php = True
            elif in_php and s == "}":
                in_php = False

        php_match = (set(c_php_adds) == set(t_php_adds)) if (not is_default and has_php) else (len(t_php_adds) == 0)

        if (set(c_listeners) == set(t_listeners) and
                set(c_directives) == set(t_directives) and
                set(c_headers) == set(t_headers) and
                php_match):
            continue

        # rebuild the file with the target state
        new_lines       = []
        listeners_added = False
        directives_added = False
        in_php           = False

        for i, line in enumerate(lines):
            s = line.strip()

            if s.startswith("listen ") and not s.startswith("#"):
                if any(p in s for p in ["80", "443"]):
                    continue

            elif s in ["http2 on;", "http3 on;"]:
                continue

            elif f"add_header Alt-Svc '{ALT_SVC}'" in line:
                continue

            elif "fastcgi_param HTTP_HOST $host;" in line:
                continue

            elif "server {" in line and not listeners_added:
                new_lines.append(line)
                base = "    "
                for j in range(i + 1, min(i + 10, len(lines))):
                    nxt = lines[j]
                    if nxt.strip() and not nxt.strip().startswith("#"):
                        base = nxt[: len(nxt) - len(nxt.lstrip())]
                        break
                for l in t_listeners:
                    new_lines.append(f"{base}{l};\n")
                listeners_added = True
                continue

            elif s.startswith("server_name") and not directives_added:
                new_lines.append(line)
                base = _indent(lines, i)
                for d in t_directives:
                    new_lines.append(f"{base}{d};\n")
                if not is_default:
                    for h in t_headers:
                        new_lines.append(f"{base}{h};\n")
                directives_added = True
                continue

            elif "location ~ \\.php$" in s and not is_default and t_php_adds:
                new_lines.append(line)
                php_ind = _php_indent(lines, i)
                for a in t_php_adds:
                    new_lines.append(f"{php_ind}{a};\n")
                continue

            else:
                new_lines.append(line)

        try:
            cf.write_text("".join(new_lines))
            action = "enabled" if http3 else "disabled"
            logger.warning(f"http3_enable: {action} — updated {filename}")
            any_changed = True
        except Exception as e:
            logger.error(f"Failed to write {filename}: {e}")

    return any_changed


# ---------------------------------------------------------------------------
# apply_quic_gso_enable
# ---------------------------------------------------------------------------

def apply_quic_gso_enable(config, logger):
    """
    Remove quic_gso on from all vhost confs unconditionally.
    quic_gso and related QUIC directives are managed in nginx.conf by apply_nginx_conf().
    """
    conf_files  = _site_confs()
    any_changed = False

    for cf in conf_files:
        filename = cf.name

        try:
            lines = cf.read_text().splitlines(keepends=True)
        except Exception as e:
            logger.error(f"Failed to read {filename}: {e}")
            continue

        has_gso = any(l.strip() == "quic_gso on;" for l in lines)
        if not has_gso:
            continue

        new_lines = [l for l in lines if l.strip() != "quic_gso on;"]
        try:
            cf.write_text("".join(new_lines))
            logger.warning(f"quic_directives_enable: removed quic_gso from vhost — {filename}")
            any_changed = True
        except Exception as e:
            logger.error(f"Failed to write {filename}: {e}")

    return any_changed


