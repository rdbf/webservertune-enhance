def cleanup(logger):
    """Strip all nginxtune-managed content from vhost confs and nginx.conf."""
    logger.warning("nginxtune cleanup: resetting all vhost confs to defaults")
    apply_nginx_conf(            {}, logger)
    apply_http3_enable(          {}, logger)
    apply_quic_gso_enable(       {}, logger)
    # remove generated cache-exclude files, then strip their include lines
    _apply_cache_excludes(       {}, logger)
    apply_include_features(      {}, logger)
    apply_logging_features(      {}, logger)
    apply_fastcgi_cache_settings({}, logger)
    apply_client_max_body_size(  {}, logger)
    logger.warning("nginxtune cleanup: complete")


